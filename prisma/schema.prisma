// Prisma schema — Freshman Academy mentoring-hours platform.
//
// NOTE ON ENUMS: SQLite does not support Prisma enums, so `role` and `status`
// are strings. The allowed values are defined as TypeScript constants in
// `src/lib/constants.ts` and enforced in application code. When migrating to
// Postgres, these columns can be converted to real enums.
//
// NOTE ON DERIVED VALUES: allotted / completed / remaining time is computed
// from HourAllocation rows vs. ACTIVE sessions (see src/lib/hours.ts).
// It is intentionally NOT stored as columns.
//
// NOTE ON UNITS: every duration in this schema is a whole number of MINUTES.
// They were decimal hours until Aug 29 2026; the migration converted each one
// as round(hours * 60), which recovered the whole minutes they had been
// rounded down from. Integers, so sums are exact and the float-noise guards
// the old code carried around are gone. The `HourAllocation` /
// `HourAllotmentChange` model names keep their history — renaming the tables
// would buy nothing the columns don't already say.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          String // ADMIN | DEPT_LEADER | SALES | MENTOR | STUDENT
  isMentor      Boolean  @default(false) // ADMINs with this flag can also act as a mentor and toggle into the mentor dashboard
  // Runs the platform: sees every program without a grant, and is the only
  // person who can write ProgramStaff rows. Everyone else who administers
  // anything does it through the grants below, program by program.
  platformAdmin Boolean  @default(false)
  status        String   @default("ACTIVE") // ACTIVE | UNASSIGNED (freshly signed-up mentors) | PENDING (self-signed-up students awaiting approval)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Profile picture. The BYTES live in AvatarImage; this column carries only
  // "is there one, and how new is it" so that the chip components can decide
  // whether to render an image, and so the served URL can be cache-busted.
  // Kept here rather than joined because a person chip appears in every table.
  avatarUpdatedAt DateTime?

  // The Monday hours email. On by default — it is the reminder that stops hours
  // expiring unnoticed — and switchable off from /notifications or the
  // unsubscribe link in the footer of every send.
  weeklyDigest    Boolean   @default(true)
  // When the last digest actually went out. This is the idempotency guard: a
  // re-run of the cron, or two instances firing at once, must not send twice.
  digestSentAt    DateTime?
  // The last time this person opened /changelog. The dot on the account button
  // is "the newest entry is dated after this" — or after createdAt, for someone
  // who has never opened it, so a new user is not shown history that predates
  // them. A day, not an entry id: see docs/superpowers/specs/2026-10-02-changelog-design.md.
  changelogSeenAt DateTime?
  // WHAT they had read then: a JSON object of entry date -> number of bullets
  // that day had. An entry is unseen when its day is missing here or has grown,
  // so a bullet added to a day somebody already read, and an entry committed
  // before their last visit but deployed after it, both light the dot — which a
  // comparison of dates against `changelogSeenAt` never could. Null until the
  // first visit; the createdAt floor above applies until then.
  changelogSeen   String?
  // The Google account's own id (the `sub` Google signs in with). It is how a
  // Google Meet participant — who arrives as `users/<id>`, never as an email —
  // is recognised as this person. Recorded at sign-in; null until their next.
  googleId        String?   @unique

  studentProfile      StudentProfile?          @relation("StudentUser")
  createdStudents     StudentProfile[]         @relation("CreatedBy")
  enrolledStudents    StudentEnrollment[]      @relation("EnrolledBy")
  mentorAssignments   MentorAssignment[]       @relation("MentorUser")
  staffGrants         ProgramStaff[]           @relation("StaffGrantUser")
  grantsMade          ProgramStaff[]           @relation("StaffGrantCreatedBy")
  mentorSessions      Session[]                @relation("SessionMentor")
  mentorClasses       ScheduledClass[]         @relation("ClassMentor")
  hourAllocations     HourAllocation[]         @relation("AllocationMentor")
  assignments         Assignment[]             @relation("AssignmentMentor")
  createdAssignments  Assignment[]             @relation("AssignmentCreatedBy")
  tasksSet            StudentTask[]            @relation("StudentTaskMentor")
  mentorTasksSet      MentorTask[]             @relation("MentorTaskCreatedBy")
  mentorTasks         MentorTaskAssignee[]     @relation("MentorTaskAssignee")
  allotmentChanges    HourAllotmentChange[]    @relation("ChangedBy")
  allotmentMentions   HourAllotmentChange[]    @relation("ChangeMentor")
  notifications       Notification[]
  causedNotifications Notification[]           @relation("NotificationActor")
  mentorFeedback      MentorFeedback[]         @relation("FeedbackMentor")
  avatarImage         AvatarImage?
  notificationPrefs   NotificationPreference[]
  dismissals          StatusDismissal[]
  exchangesSent       ProgramExchange[]        @relation("ExchangeSentBy")
  exchangesReturned   ProgramExchange[]        @relation("ExchangeReturnedBy")
  bugsReported        BugReport[]              @relation("BugReporter")
  bugsTriaged         BugReport[]              @relation("BugTriager")
  applicationEdits    StudentApplication[]     @relation("ApplicationUpdatedBy")
  universitiesAdded   University[]             @relation("UniversityCreatedBy")
  googleConnection    GoogleConnection?
  meetDrafts          MeetDraft[]              @relation("MeetDraftMentor")
  partnerMentorships  PartnerMentor[]
  partnerFeedback     PartnerFeedback[]        @relation("PartnerFeedbackMentor")
}

// One profile picture, stored in the database rather than on disk so it travels
// with the DB backup and behaves identically in dev and on Render.
//
// Deliberately its OWN table: `avatar Bytes?` on User would be pulled into
// memory by every `include: { mentor: true }` in the app (Prisma selects all
// scalars), which is most queries here. Only /api/avatar/[id] reads this table.
//
// Images are resized and re-encoded in the browser before upload (see
// src/lib/avatar.ts), so rows are tens of kilobytes, not megabytes. mimeType is
// what the server SNIFFED from the bytes, never what the client claimed.
model AvatarImage {
  userId   String @id
  bytes    Bytes
  mimeType String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Program {
  id                String                @id @default(cuid())
  name              String                @unique
  // ACTIVE | ARCHIVED. A finished program stops appearing in the pickers
  // without being deleted — deletion is refused while it holds students, and
  // a program that ran is part of the record either way.
  status            String                @default("ACTIVE")
  archivedAt        DateTime?
  // Does allocating time here also record what the student paid?
  //
  // A column rather than a comparison against the program's NAME, which is how
  // this was decided at four call sites: renaming the Master's Program — which
  // its own settings page offers — would have switched the money fields off
  // across the app, silently.
  tracksPayment     Boolean               @default(false)
  // Does each student here hold ONE bank of hours that every mentor's meeting
  // draws down, instead of separate time per mentor? A column for the same
  // reason as `tracksPayment`: Full Support and the Master's Program are
  // identified by a setting an admin can read, not by what they are called.
  hourBank          Boolean               @default(false)
  // Does this program log its hours as CLASSES? Its roster entries are groups,
  // added by name with no email or sign-in, and an hour is logged for a group.
  // A group is an ordinary student record underneath, so ledgers, deadlines and
  // scoping are the ones every other program has. Off by default.
  classHours        Boolean               @default(false)
  // Does this program follow its students' university APPLICATIONS — a
  // snapshot of scores, the motivational essay's stage, and a list of
  // universities with a supplemental essay each? A column for the reason
  // `hourBank` is one: Full Support is the program an admin switched it on
  // for, not the one with that name. Off by default.
  tracksAdmissions  Boolean               @default(false)
  // Do this program's mentors schedule CLASSES in the platform — a dated time
  // for a student, reserved out of the hours that student holds with them, and
  // totalled by month? A column for the reason `hourBank` is one: SAT is the
  // department an admin switched it on for, not the one with that name. Off by
  // default, and a platform admin's to turn on — see `setProgramSchedulesClasses`.
  schedulesClasses  Boolean               @default(false)
  // The standard grant: every student who joins this program is given
  // `standardMinutes` — in their unassigned pool, or in their hour bank where
  // `hourBank` is on — to use within `standardDays` of joining. Both set or both null (off). It is how a program that is one
  // LEVEL of a department — Beginner, Advanced — says what the level buys,
  // instead of an admin re-typing the same grant for every student. Only a
  // student joining afterwards gets it; changing it touches nobody already in.
  standardMinutes   Int?
  standardDays      Int?
  // PROGRAM | INSTITUTE. An institute is an ordinary program in the ledger —
  // same grants, same keys, same exchanges — that the people who work ONLY in
  // it see as a place of its own: its name in the chrome, its levels in the
  // sidebar, its own frame on analytics (see lib/space.ts). Everyone else,
  // platform admins included, sees one program among the others. A column for
  // the reason `tracksPayment` is one: renaming the program must not switch
  // the institute off.
  space             String                @default("PROGRAM")
  // What the institute is called in its own chrome — "Research Institute" —
  // which is not the program's name in everybody else's tables. Null falls
  // back to the program's name.
  spaceName         String?
  // Which of the eight program colours this program wears (0–7), given when
  // it is created — the first slot no live program holds. Stored, not hashed
  // from the id, so no two programs share a colour by accident and every page
  // draws the same one (lib/program-tone.ts).
  colorIndex        Int                   @default(0)
  levels            ProgramLevel[]
  cohorts           Cohort[]
  enrollments       StudentEnrollment[]
  mentorAssignments MentorAssignment[]
  staffGrants       ProgramStaff[]
  // The ledger, program by program. A student may be enrolled in several, and
  // the time they hold in one is not the time they hold in another: these
  // back-relations are what makes "this program's hours" a query rather than a
  // sum somebody has to remember to filter.
  hourAllocations   HourAllocation[]
  sessions          Session[]
  scheduledClasses  ScheduledClass[]
  assignments       Assignment[]
  studentTasks      StudentTask[]
  mentorTasks       MentorTask[]
  allotmentChanges  HourAllotmentChange[]
  // Students this program lent out, and students it took in. Two relations
  // because they are two questions an admin asks separately.
  exchangesSent     ProgramExchange[]     @relation("ExchangeFrom")
  exchangesHosted   ProgramExchange[]     @relation("ExchangeTo")
}

// One person may administer one program. This table IS the permission model
// for staff: `platformAdmin` sees everything, and everyone else sees exactly
// the programs they hold a row for.
//
// Deliberately not a column on User: an admin routinely covers two programs
// and not the third, which a single `programId` cannot say. It is also an
// audit trail — who granted this, and when — because access that appears
// without a name beside it is the kind nobody removes.
//
// Written from ONE place only (/settings/platform). The seed never writes
// here: a grant list in config would be re-applied on every boot and would
// quietly restore an admin the owner had just removed.
model ProgramStaff {
  id          String   @id @default(cuid())
  userId      String
  programId   String
  // ADMIN | LEADER | SALES — what this person may do inside this program.
  // Every level reads (adminScope); only ADMIN writes (adminWriteScope —
  // LEADER and SALES are the old roles kept as read-only membership).
  role        String
  createdById String? // the platform admin who made the grant; null for the migration backfill
  createdAt   DateTime @default(now())

  user      User    @relation("StaffGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("StaffGrantCreatedBy", fields: [createdById], references: [id])

  @@unique([userId, programId])
}

// One level of a program — "Emerging" inside Research, where a cohort is one
// intake of it.
//
// Why a row of its own rather than cohorts with a shared prefix, or programs
// named "Emerging Researchers Program": the level is what the standard grant
// belongs to (Emerging buys two hours, Advanced fifteen, Frontiers twenty —
// the reason these were separate PROGRAMS until 3 October 2026), and a grant
// typed onto every cohort of a level is the same figure re-entered, which is
// the mistake `Program.standardMinutes` exists to prevent one row up.
//
// A program either has levels or has flat cohorts — never both. Global
// Admissions' "Spring 25" needs no level above it, so `Cohort.levelId` stays
// null there, and a level is refused while a program still holds level-less
// cohorts (see createLevel): a cohort that could sit under two shapes is one
// nobody has to ask about.
model ProgramLevel {
  id              String @id @default(cuid())
  programId       String
  name            String
  // The standard grant for THIS level — same pair as Program.standardMinutes /
  // standardDays, resolved by grantStandardHours level-first. A leveled program
  // leaves its own pair null: the level is what was bought.
  standardMinutes Int?
  standardDays    Int?

  program           Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohorts           Cohort[]
  enrollments       StudentEnrollment[]
  mentorAssignments MentorAssignment[]

  @@unique([programId, name])
}

model Cohort {
  id        String  @id @default(cuid())
  name      String
  programId String
  // The level this intake sits under, in programs that have levels. Null in a
  // program with flat cohorts (Global Admissions) — the only other shape a
  // cohort takes.
  levelId   String?

  program           Program             @relation(fields: [programId], references: [id])
  level             ProgramLevel?       @relation(fields: [levelId], references: [id], onDelete: SetNull)
  enrollments       StudentEnrollment[]
  mentorAssignments MentorAssignment[]

  // Per level, so "Fall 2026" under Emerging and "Fall 2026" under Advanced
  // are two intakes, not a collision. NULLs are distinct in a unique index, so
  // a flat program's names are guarded by the create action rather than here.
  @@unique([programId, levelId, name])
}

// A mentor's assignment to a program — to one level or one cohort within it,
// for programs that have them (levels in Research, cohorts in Global
// Admissions). cohortId and levelId both null is program-wide. The Calendly
// booking link lives on the pairing
// but is set by the MENTOR (admins only create the pairing); it stays null
// until the mentor fills it in.
// NOTE: SQLite treats NULLs as distinct in unique indexes, so uniqueness of
// program-wide rows (cohortId null) is enforced in the assignMentor action.
model MentorAssignment {
  id          String   @id @default(cuid())
  mentorId    String
  programId   String
  // A pairing names the WIDEST thing it covers: program-wide (both null), one
  // level (levelId, every cohort under it now and later), or one cohort. A
  // cohort pairing carries no levelId — the cohort names its own, and storing
  // it twice would be a fact that could disagree.
  cohortId    String?
  levelId     String?
  calendlyUrl String?
  createdAt   DateTime @default(now())

  mentor  User          @relation("MentorUser", fields: [mentorId], references: [id])
  program Program       @relation(fields: [programId], references: [id])
  cohort  Cohort?       @relation(fields: [cohortId], references: [id])
  // Cascade, not SetNull: if a level somehow goes while a pairing still names
  // it, the honest end is the pairing going with it — SetNull would quietly
  // widen the mentor's reach to the whole program.
  level   ProgramLevel? @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([mentorId, programId, cohortId, levelId])
}

// The person. ONE row per student account, however many programs they study
// in — which is why no `programId` lives here any more.
//
// It was a column until 6 September 2026, and that column WAS the assumption
// that a student belongs to exactly one program. A student who finished Global
// Admissions and went on to the Master's Program could only be represented by
// moving them, which rewrote history: their old program's totals lost them,
// and the hours they had used there followed them into a program that never
// granted them. The enrollment is its own row now, and the ledger says which
// program each grant, session and task belongs to.
model StudentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  telegramUsername   String? // collected during the student's first sign-in
  // When we last nudged them to supply one. Null means never asked. Kept so a
  // re-run of the reminder job is a no-op rather than a second email, the same
  // guard `User.digestSentAt` gives the weekly digest.
  telegramReminderAt DateTime?
  folderUrl          String? // link to the student's folder (Drive/Docs/…), for mentors
  createdById        String // staff user who created the student, or the student themself (self-signup)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user              User                  @relation("StudentUser", fields: [userId], references: [id])
  createdBy         User                  @relation("CreatedBy", fields: [createdById], references: [id])
  enrollments       StudentEnrollment[]
  sessions          Session[]
  meetDrafts        MeetDraft[]
  scheduledClasses  ScheduledClass[]
  hourAllocations   HourAllocation[]
  assignments       Assignment[]
  tasks             StudentTask[]
  allotmentChanges  HourAllotmentChange[]
  mentorFeedback    MentorFeedback[]
  exchanges         ProgramExchange[]
  interviewSlots    InterviewSlot[]
  mentorTasks       MentorTaskStudent[]
  interviewsHosted  PeerInterview[]       @relation("InterviewHost")
  interviewsBooked  PeerInterview[]       @relation("InterviewGuest")
  interviewAnswers  InterviewAnswer[]
  interviewFeedback InterviewFeedback[]
  application       StudentApplication?
  universities      StudentUniversity[]
}

// One student, in one program — the membership fact, and nothing else.
//
// A student may hold several. Every question the app used to ask of
// `StudentProfile.programId` ("may this admin see them?", "does this mentor
// reach them?", "who is in this program?") is now a question about whether ANY
// of these rows matches, which is why the unique key is the pair: enrolling
// somebody twice in the same program is not a second membership, it is a
// double-click.
//
// The cohort belongs here rather than on the profile for the same reason the
// program does — a student in two programs is in at most one cohort of each,
// and a single column could not say which cohort went with which program.
model StudentEnrollment {
  id          String   @id @default(cuid())
  studentId   String
  programId   String
  // The level within a leveled program (Emerging in Research). Required when
  // the program has levels; null everywhere else. When cohortId is also set,
  // the cohort must belong to this level — resolveEnrollment enforces the
  // agreement rather than trusting the form's two selects to have been built
  // consistently.
  levelId     String?
  cohortId    String? // set where the enrollment names an intake cohort — flat under Global Admissions, under a level in a leveled program
  // Who enrolled them. Null for the rows the migration created out of the old
  // single-program column, which nobody made — the same convention as
  // `ProgramStaff.createdById`.
  createdById String?
  // Set when this membership is an EXCHANGE rather than an enrollment: a
  // student another program sent here for a capped number of hours. It is the
  // one place the difference is recorded, and everything that reads a roster
  // reads it — a visitor is in the program for as long as the hours last, and
  // is not the program's own student.
  exchangeId  String?  @unique
  createdAt   DateTime @default(now())

  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program   Program          @relation(fields: [programId], references: [id])
  level     ProgramLevel?    @relation(fields: [levelId], references: [id], onDelete: SetNull)
  cohort    Cohort?          @relation(fields: [cohortId], references: [id])
  createdBy User?            @relation("EnrolledBy", fields: [createdById], references: [id])
  exchange  ProgramExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@unique([studentId, programId])
  @@index([programId])
  @@index([levelId])
}

// One student, lent by one program to another for a capped number of hours.
//
// The school runs three programs and its mentors do not stop at the edge of
// theirs: a mentor in Imkon meets a student who needs seven hours of Global
// Admissions' help, and nobody in Global has heard of them. Before this, the
// only way to arrange that was to enroll the student in Global outright, which
// says something quite different — that they study there — and hands Global's
// admins the whole of a student they were asked to help with for an afternoon.
//
// So the placement is its own row, and it says three things a plain enrollment
// cannot: who sent them, how much time was promised, and by when. The hours are
// NEW time, not a transfer: the sending mentor is not spending their own
// program's grant, they are saying "this student may take up to seven hours
// here". The host program's admin then allocates those hours among its own
// mentors, and may allocate no more than the cap.
//
// Both programs read the same rows afterwards. The allocations and sessions
// live in the HOST program, where the work happens and where the ledger's rules
// put them, and they carry `exchangeId` so the SENDING program can read exactly
// them and nothing else of the host's. That column is the whole of the
// both-ends view: without it the home program would have to ask about a student
// in a program it does not administer, which is the question `studentScope`
// exists to refuse.
model ProgramExchange {
  id            String    @id @default(cuid())
  studentId     String
  // Where they came from, and where they were sent. Both required: an exchange
  // with one program named is an enrollment with extra words.
  fromProgramId String
  toProgramId   String
  // The ceiling, in minutes. The host may allocate this much and no more; it
  // rises only when the sender sends more.
  minutes       Int
  // Use-by for the whole placement. The host's own allocations carry their own
  // deadlines, and none of them may outlive this one — time the sender did not
  // promise is time the host cannot grant.
  deadline      DateTime
  // Why, in the sender's words. What the student is coming for.
  note          String?
  // OPEN | RETURNED. See EXCHANGE_STATUS in lib/constants.ts. A returned
  // exchange kept its row: who was sent where, and that it came back, is the
  // record both programs need. Returning is refused once anything was logged.
  status        String    @default("OPEN")
  sentById      String
  returnedById  String?
  returnedAt    DateTime?
  returnNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student     StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromProgram Program            @relation("ExchangeFrom", fields: [fromProgramId], references: [id])
  toProgram   Program            @relation("ExchangeTo", fields: [toProgramId], references: [id])
  sentBy      User               @relation("ExchangeSentBy", fields: [sentById], references: [id])
  returnedBy  User?              @relation("ExchangeReturnedBy", fields: [returnedById], references: [id])
  // The membership it created in the host program, while it is open.
  enrollment  StudentEnrollment?
  allocations HourAllocation[]
  sessions    Session[]

  @@index([studentId])
  @@index([toProgramId, status])
  @@index([fromProgramId, status])
}

// One planned piece of work for a student: what it is for, which mentor is
// doing it, how many hours it may take, by when, and how far along it is. This
// is the right-hand half of the tracking spreadsheet, and only an admin fills
// it in; the left-hand half is Session rows that mentors log.
//
// Deliberately NOT part of HourAllocation, which is unique per (student,
// mentor): one consultant routinely has several assignments for the same
// student (an essay, a recommendation letter, a general review), each with its
// own hour limit and status. HourAllocation stays the hours ledger that
// sessions draw down and deadlines forfeit; an Assignment is the plan on top,
// so `minuteLimit` is a budget for that piece of work, not a grant of time.
model Assignment {
  id             String    @id @default(cuid())
  studentId      String
  // The program whose work this is. A task is planned against a program's
  // hours, so it carries the same program as the grant that budgeted it, and a
  // session may only name a task from its own program.
  programId      String
  // Null = no consultant chosen yet: the work is planned and budgeted but not
  // on anyone's list. An admin picks the consultant later via the row's edit.
  mentorId       String?
  purpose        String // what this work is: "Main essay", "Recommendation letters"
  minuteLimit    Int? // minutes this piece of work should take; null = not budgeted
  // When the work is due, in the two forms it actually comes in.
  //
  // `dueNote` is free text on purpose: the tracking sheet holds both "Aug 7"
  // and "March-May", and the second is not a date. `dueOn` is a real date when
  // there is one, and it is the ONLY thing that decides whether a task is
  // overdue — a range a task is still inside must never be flagged.
  //
  // Neither is HourAllocation.deadline, which is a hard date that forfeits the
  // hours it carries. Missing a task's due date costs nothing automatically.
  dueNote        String?
  dueOn          DateTime?
  // What a person needs to say about this task that the state can't: "missed an
  // hour, not excused", "GMAT prep but when?". The tracking spreadsheet wrote
  // exactly this into its Progress cells next to the state, so a status word
  // alone would have dropped the half that matters on import.
  note           String?
  // NOT_STARTED | IN_PROGRESS | DONE. Normally DERIVED from time logged against
  // this goal (see lib/goal-progress.ts): the first session moves it to
  // IN_PROGRESS, reaching minuteLimit moves it to DONE.
  progress       String    @default("NOT_STARTED")
  // Set when an ADMIN states the progress by hand, which pins it: work finished
  // under budget is done even though the hours say otherwise, and auto-sync must
  // not quietly overrule a person. Cleared when the admin hands control back.
  progressManual Boolean   @default(false)
  // Ties a row to its place in the list, so reordering never depends on
  // createdAt and two rows added in the same second keep a stable order.
  position       Int
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student   StudentProfile @relation(fields: [studentId], references: [id])
  program   Program        @relation(fields: [programId], references: [id])
  mentor    User?          @relation("AssignmentMentor", fields: [mentorId], references: [id])
  createdBy User           @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  sessions  Session[]

  @@index([studentId, position])
  @@index([programId])
}

// Work the student goes away and DOES — set by the mentor they sit with, and
// moved along by the student themselves.
//
// Deliberately not an `Assignment`, which the two were nearly merged into. An
// Assignment is the *agenda*: the piece of work an admin budgets hours for, so
// a session can be logged against it and the plan read against the ledger. It
// is measured in minutes somebody else delivers, and nobody but staff ever
// touches it.
//
// This is the other half of the same week and shares none of that shape. It
// carries no minutes and no budget, no session may be logged against it, and
// the only person who can say how far along it is is the student — which is the
// whole point of it. Putting a student-writable `percent` on `Assignment` would
// have put a student's hand on the row an admin's hour budget hangs off.
//
// The deadline is required, unlike the agenda's two optional halves. A task is
// given at a meeting to be done before the next one; "sometime" is not a task,
// it is a suggestion, and the student's home has no way to sort one.
model StudentTask {
  id          String    @id @default(cuid())
  studentId   String
  // Whose work this is, per the rule the rest of the ledger follows: ask the
  // row, not the student. A student in two programs gets tasks from both, and
  // an admin of one of them must not read the other's.
  programId   String
  // The mentor who set it. Required, and never null — a task nobody set is a
  // task nobody can be asked about, which is exactly what `Assignment.mentorId`
  // is nullable FOR (an admin budgets work before choosing who does it).
  mentorId    String
  title       String
  note        String?
  dueOn       DateTime
  // How far along the STUDENT says they are, 0-100. Whole percent, in steps the
  // control offers; the column takes any integer in range so the steps can be
  // re-cut without a migration.
  percent     Int       @default(0)
  // When the student called it finished. Null is "not finished" — the flag and
  // the date are one column, because two would let them disagree.
  //
  // Separate from `percent` reaching 100 even so: finishing is a thing a person
  // did at a moment, and it is what the mentor is told about.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program Program        @relation(fields: [programId], references: [id])
  mentor  User           @relation("StudentTaskMentor", fields: [mentorId], references: [id])

  // The student's own list, in the order their home reads it.
  @@index([studentId, dueOn])
  @@index([programId])
  @@index([mentorId])
}

// Work a program's admin hands its MENTORS — the third thing called a task,
// and the only one whose doer is staff.
//
// Not a `StudentTask`, whose doer is the student and whose setter is the
// mentor; and not an `Assignment`, which is a budget of hours a mentor delivers
// TO a student. This is a to-do between colleagues: "write Aziza's
// recommendation by Friday", set to one mentor, several, or the whole team at
// once, about none, one or several students.
//
// One task, many assignees, because "set this to everyone" is one act with one
// title and one deadline: copying the row per mentor would let an edit reach
// some of the copies. Each assignee finishes their own share, so the
// completion lives on the assignee row, not here.
//
// Program-scoped like everything else in the ledger: only an admin of
// `programId` sets, reads or withdraws it, and the mentors and students on it
// are that program's own.
model MentorTask {
  id          String   @id @default(cuid())
  programId   String
  title       String
  note        String?
  dueOn       DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program   Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("MentorTaskCreatedBy", fields: [createdById], references: [id])
  assignees MentorTaskAssignee[]
  students  MentorTaskStudent[]

  @@index([programId, dueOn])
}

// One mentor's share of a MentorTask. `completedAt` is the flag and the date
// in one column, as on StudentTask, so the two cannot disagree.
model MentorTaskAssignee {
  id          String    @id @default(cuid())
  taskId      String
  mentorId    String
  completedAt DateTime?

  task   MentorTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentor User       @relation("MentorTaskAssignee", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([taskId, mentorId])
  @@index([mentorId])
}

// A student a MentorTask is about. None is ordinary ("update your booking
// link"), and so is several ("read the three essays that came in").
model MentorTaskStudent {
  taskId    String
  studentId String

  task    MentorTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([taskId, studentId])
  @@index([studentId])
}

// Mentoring time an admin granted a student FROM a specific mentor, in minutes
// (only admins may change this, audited via HourAllotmentChange). A student's
// total allotment is the sum of their allocations; sessions logged by a mentor
// draw down that mentor's allocation.
//
// mentorId null = the student's UNASSIGNED pool: time granted before a
// consultant was chosen. It counts toward the allotment and expires like any
// other allocation, but nobody can log against them until they're moved to a
// mentor. NOTE: SQLite treats NULLs as distinct in unique indexes, so "one
// pool row per student" is enforced in setMentorAllocation, not here.
model HourAllocation {
  id            String   @id @default(cuid())
  studentId     String
  // Which program this time was granted IN. Required: a grant with no program
  // could not be shown on a program's page, scoped to the admins who made it,
  // or told apart from the grant the same student holds in another program.
  programId     String
  mentorId      String?
  minutes       Int
  amountPaid    Float? // total the student paid for this time; collected only for Master's Program allocations (null elsewhere)
  deadline      DateTime // required date the time must be used by; shown to student and mentor. Once it passes, unused minutes are FORFEITED and no new sessions may be logged against the allocation.
  deadlineStage String? // reminder bookkeeping: null | UPCOMING_SENT | PASSED_SENT; reset when the deadline changes
  // Set when this grant spends an exchange another program sent. The hours are
  // this program's to allocate and this program's to deliver; the column is
  // what keeps their total under the cap, and what lets the sending program
  // read them without being given the student's whole record here.
  exchangeId    String?
  // The student's HOUR BANK in this program: no mentor, and the row every
  // `Session.fromBank` meeting draws down. One per (student, program). Not the
  // unassigned pool, which is also mentor-less but is carved into a mentor's own
  // allocation by the first meeting. A bank is carved only by an admin, into a
  // mentor's share (`fromBankShare`), never by a meeting.
  isBank        Boolean  @default(false)
  // A MENTOR's time an admin handed out of this student's hour bank in this
  // program. The minutes left the bank when it was granted and go back to it
  // when it is cut or removed, so the bank plus its shares is the student's
  // whole balance. Meetings with this mentor draw this row, not the bank;
  // meetings with a mentor who holds no share still draw the bank. False on
  // every row granted before 13 October 2026, including the per-mentor time a
  // bank was created beside: that time was never the bank's to take back.
  fromBankShare Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student  StudentProfile   @relation(fields: [studentId], references: [id])
  program  Program          @relation(fields: [programId], references: [id])
  mentor   User?            @relation("AllocationMentor", fields: [mentorId], references: [id])
  exchange ProgramExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  // One grant per mentor per program per student. The program is part of the
  // key, not decoration: the same mentor may hold time with the same student in
  // two programs, with two deadlines and two balances, and those must not
  // collide into one row.
  @@unique([studentId, programId, mentorId])
  @@index([programId])
  @@index([exchangeId])
}

// A completed mentoring session logged by a mentor, in minutes. ACTIVE sessions
// draw down the student's time; VOIDED sessions do not count.
model Session {
  id           String   @id @default(cuid())
  studentId    String
  // Which program the meeting happened in — and so which allocation it draws
  // down. Derived from the student's single program until 6 September 2026;
  // stored since, because a student in two programs has two balances and a
  // session that cannot say which one it spent is a session that spends both.
  programId    String
  mentorId     String
  // Which task this meeting went toward. Optional: naming one is how planned
  // hours are read against delivered ones, but a meeting that fits none of them
  // still happened and still has to be loggable — and the sessions logged before
  // tasks existed keep their history instead of being backfilled with a guess.
  assignmentId String?
  minutes      Int
  date         DateTime
  attended     Boolean  @default(true) // was the student present? false = no-show; the time is still charged but tallied as "missed"
  late         Boolean  @default(false) // the student turned up, but late — a label on the meeting, not on the time
  note         String? // what was covered, in the mentor's words (one field, optional)
  // ACTIVE | VOIDED | RESCHEDULED. Only ACTIVE sessions draw time down: a
  // voided one gave it back, and a rescheduled one never delivered anything —
  // it is a record that the meeting moved.
  status       String   @default("ACTIVE")
  // Does this meeting come OUT of the time the student was allocated?
  //
  //   true  (default)  in-plan: the minutes draw the allocation down, as always
  //   false            out-of-plan: extra work beyond what was granted. It is
  //                    logged, visible and counted toward the task it served,
  //                    but it charges no allocation and moves no balance.
  //
  // Nothing reads this column raw — `chargesAllocation()` in lib/constants.ts is
  // the one place the rule lives, so "does out-of-plan spend time?" stays a
  // single decision rather than a filter copied into a dozen queries.
  withinPlan   Boolean  @default(true)

  // What the STUDENT says about the meeting the mentor logged.
  //
  // Until 8 September 2026 hours moved on one party's word: a mentor logged a
  // session, the student's balance changed, the student was notified, and there
  // was nowhere for them to say "that did not happen" or "it was 30 minutes,
  // not 60". The ledger's own promise is that these numbers are trusted by
  // everyone, and trust that cannot be withheld is not trust.
  //
  //   null        not answered yet
  //   CONFIRMED   the student says it happened
  //   DISPUTED    the student says something is wrong; the note says what
  //
  // Deliberately does NOT move the balance. A dispute is a flag for a human,
  // not an automatic reversal — an admin corrects or voids the session, which
  // is already an audited write. A student who could reverse a charge by
  // pressing a button would be a student who could reverse it by mistake.
  studentAnswer     String?
  studentAnsweredAt DateTime?
  // 1-5 on the session itself, not on the mentor. `MentorFeedback` rates a
  // person over time and names the writer only to that student's admins; this
  // rates one meeting and is not anonymous, because a mentor cannot act on
  // "one of your sessions was a 2".
  studentRating     Int?
  // Their words: what was wrong, or what was good. Optional either way.
  studentNote       String?

  // The exchange this meeting was delivered under, copied from the student's
  // membership at the moment it was logged. Stored rather than derived so the
  // log reads the same to both programs forever: the sending program asks for
  // its own exchange's sessions, not for "this student, in that program",
  // which would be a question about a program it does not administer.
  exchangeId String?

  // Does this meeting draw down the student's hour bank rather than the time
  // held with its mentor? Stored, like `exchangeId`, because the answer changes
  // when a bank is created "including previous hours": the meetings already
  // logged are re-pointed at it, and nothing derived from a date could say
  // which ones.
  fromBank Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student    StudentProfile   @relation(fields: [studentId], references: [id])
  program    Program          @relation(fields: [programId], references: [id])
  mentor     User             @relation("SessionMentor", fields: [mentorId], references: [id])
  exchange   ProgramExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)
  // The class this meeting delivered, when it was marked held against it.
  scheduledClass ScheduledClass?
  // SetNull, not Cascade: deleting a goal must never delete the time that was
  // already delivered against it. The session survives, minus its goal.
  assignment Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([programId])
  @@index([exchangeId])
  @@index([studentId, programId, mentorId])
}

// A class a mentor put in the diary: a dated time for one student, in one
// program, reserved out of the hours that student holds with that mentor.
//
// Only programs with `schedulesClasses` switched on offer it. A class is a PLAN,
// not a meeting: it draws nothing down. The ledger moves when the mentor logs
// the meeting as a Session, as it always has, and `sessionId` is the join
// between the two — so "scheduled" and "delivered" are read side by side, per
// student per month, without a second balance that could disagree with the first.
//
//   SCHEDULED  in the diary; its minutes are RESERVED against the allocation
//   HELD       delivered; `sessionId` names the session that charged the hours
//   CANCELLED  gave its minutes back; kept, so the month still says it happened
model ScheduledClass {
  id        String   @id @default(cuid())
  studentId String
  // Which program's hours this class is reserved from. Stored for the reason
  // `Session.programId` is: a student in two programs has two balances.
  programId String
  mentorId  String
  startsAt  DateTime
  minutes   Int
  status    String   @default("SCHEDULED")
  // What the class is for, in the mentor's words. Optional.
  topic     String?
  // The meeting that delivered it. Unique: one class is one session.
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program Program        @relation(fields: [programId], references: [id])
  mentor  User           @relation("ClassMentor", fields: [mentorId], references: [id])
  session Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([programId, startsAt])
  @@index([studentId, programId, mentorId])
  @@index([mentorId, startsAt])
}

// Audit log of admin changes to a student's per-mentor allocation, in minutes.
model HourAllotmentChange {
  id          String   @id @default(cuid())
  studentId   String
  programId   String // the program whose allocation was changed
  mentorId    String? // the mentor whose allocation was changed; null = the unassigned pool
  changedById String
  oldMinutes  Int
  newMinutes  Int
  createdAt   DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id])
  program   Program        @relation(fields: [programId], references: [id])
  mentor    User?          @relation("ChangeMentor", fields: [mentorId], references: [id])
  changedBy User           @relation("ChangedBy", fields: [changedById], references: [id])
}

// One thing that happened, addressed to one person. See lib/notify.ts — every
// producer goes through it rather than writing this table directly.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // see NOTIFICATION_TYPES in lib/constants.ts
  message   String
  // Where this notification is ABOUT. Without it a reader learns that something
  // happened and then has to go hunt for the student it happened to.
  href      String?
  // Who caused it, when that was a person: shown as their identity chip so a
  // list of events is scannable by who did them. Null for system notices like
  // deadline reminders.
  actorId   String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  // Which of the six things this is about: HOURS | SESSIONS | MEETINGS | TASKS
  // | DEADLINES | ACCOUNTS. See NOTIFICATION_CATEGORY in lib/constants.ts.
  //
  // Stored rather than derived from `type` at read time, because it is what the
  // feed filters on and what the per-category email preferences switch — and a
  // mapping living in a switch statement is one the database cannot group by.
  category  String    @default("ACCOUNTS")
  // When it was read. `read` stays for the unread badge and the unsubscribe
  // path; this is the half that lets a feed say "new since you last looked".
  readAt    DateTime?

  user  User  @relation(fields: [userId], references: [id])
  // SetNull so removing a staff account never deletes the history of what they
  // did; the notification survives without its chip.
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

// What one person wants to hear about, per category, and where.
//
// Absence is the default and means "in the app, not by email" — which is what
// everybody had before this table existed. A row appears only when somebody
// expresses a preference, so the table is the size of the decisions actually
// made rather than users x categories.
model NotificationPreference {
  userId   String
  // One of NOTIFICATION_CATEGORY, or WEEKLY_SUMMARY — which is a subscription
  // rather than a kind of notice, and is why this is a string.
  category String
  inApp    Boolean @default(true)
  email    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

// One attention row this reader has chosen not to see again.
//
// The rows are derived, so there is nothing on them to mark as read. Most clear
// themselves when the thing they describe is dealt with; the few that cannot —
// a mentor nobody intends to place, an imported student who will never sign in
// — would otherwise sit on the inbox forever, and a list that always carries
// the same row stops being read.
//
// Per READER on purpose: this is an opinion about a list, not a fact about the
// school, and one admin having seen enough must not hide a row from everyone.
model StatusDismissal {
  userId    String
  // A StatusType from lib/status.ts.
  type      String
  /// The student, mentor, program or task it is about; "" for a rolled-up row.
  subjectId String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, subjectId])
}

model MentorFeedback {
  id        String   @id @default(cuid())
  studentId String
  mentorId  String
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id])
  mentor  User           @relation("FeedbackMentor", fields: [mentorId], references: [id])
}

// A time one student has offered for a practice interview with a classmate.
//
// Students rehearse admissions interviews on each other: one offers a few
// times, a classmate who shares one of their own programs books one and picks
// the questions. Nothing here touches the ledger — no hours, no mentor, no
// program column. It is not a meeting a mentor arranges (that left the product
// on 15 Sep 2026, with the old `Interview` table); it is two students
// practising. The two of them read these rows, and so does any mentor who has
// ever held a grant, a session or a task with either student (`mentorHasWorkedWith`,
// read by `interviewsOfStudent`) — never another student, never an admin by role.
//
// `startsAt` is the program's wall clock in a UTC field, the convention
// lib/when.ts documents: the student types "15:00" meaning 15:00 Tashkent,
// and every reader is handed back that same 15:00.
model InterviewSlot {
  id         String   @id @default(cuid())
  studentId  String
  startsAt   DateTime
  minutes    Int
  // Where the two students meet — a Meet or Zoom link, https only, optional.
  // Shown to the two students of a booked interview, never to classmates
  // browsing open times.
  meetingUrl String?
  createdAt  DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Null while the time is open. Being booked IS this row existing: the slot
  // has no flag of its own that could disagree with it.
  interview PeerInterview?

  @@unique([studentId, startsAt])
  @@index([startsAt])
}

// One booked practice interview between two students.
//
// Unique on the slot, which is what makes a time bookable once: two classmates
// pressing Book at the same moment meet this constraint, not a race. Cancelling
// deletes the row, and the slot is open again.
//
// Completed is `completedAt`, not a status column — the flag and the date are
// one column, as `StudentTask.completedAt` is, because two would let them
// disagree. Either student may set it.
//
// Absent is `absentId`: the student who did not join, named by the one who did.
// It is a student id rather than a flag per side so that only one of the two can
// ever be absent. An absent interview is closed but not completed — there is
// nothing to write notes about — and the actions refuse to do both.
//
// Notes are per side and private to their writer: what one student thought of
// the other's answers is theirs to keep, not something the other reads.
model PeerInterview {
  id          String    @id @default(cuid())
  slotId      String    @unique
  // The student who offered the time, and the one who took it.
  hostId      String
  guestId     String
  // An id from INTERVIEW_TEMPLATES in lib/interview-templates.ts. Fixed by the
  // product; students choose one and never write their own.
  template    String
  completedAt DateTime?
  // The student marked absent by their partner — hostId or guestId — or null.
  absentId    String?
  hostNotes   String?
  guestNotes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  slot     InterviewSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  host     StudentProfile      @relation("InterviewHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest    StudentProfile      @relation("InterviewGuest", fields: [guestId], references: [id], onDelete: Cascade)
  answers  InterviewAnswer[]
  feedback InterviewFeedback[]

  @@index([hostId])
  @@index([guestId])
}

// One student's own answer to one question, typed or dictated. Private to the
// student who gave it: no page or action selects it for the partner.
//
// `question` is the wording at the time, so editing a template never relabels
// an answer already given.
model InterviewAnswer {
  id            String   @id @default(cuid())
  interviewId   String
  studentId     String
  questionIndex Int
  question      String
  text          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  interview PeerInterview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([interviewId, studentId, questionIndex])
}

// What one student says about their partner's answers. A draft is its author's
// alone; `submittedAt` is the moment it becomes the partner's to read. After it
// the author may still correct the wording until 30 minutes past the slot's end
// (FEEDBACK_EDIT_MINUTES), and then the row does not change.
model InterviewFeedback {
  id          String    @id @default(cuid())
  interviewId String
  fromId      String
  summary     String?
  wentWell    String?
  toImprove   String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  interview PeerInterview  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  from      StudentProfile @relation(fields: [fromId], references: [id], onDelete: Cascade)

  @@unique([interviewId, fromId])
}

// Something somebody reported as broken. See docs/superpowers/specs/2026-10-02-bug-reports-design.md.
//
// Each person reads their own; everyone reads only the FIX LINE of a Fixed one
// (`resolution`, `resolvedAt`, `changelogDate` — nothing else). A reporter's
// title and description can name a student, so they are never selected by the
// public list. `resolution` is the public fix line when FIXED and a note
// private to the reporter and triagers when CLOSED.
//
// Reports arrive two ways: the in-app form, and the team's Telegram group,
// where a bot reads every message and keeps the ones that are a bug or a
// feature request (lib/telegram-intake.ts). A Telegram sender is matched to an
// account by their username when a student profile holds it; otherwise
// `reporterId` is null and `telegramAuthor` is the only name there is.
model BugReport {
  id             String    @id @default(cuid())
  // SetNull: removing an account never removes what they reported.
  reporterId     String?
  reporterRole   String // the role at the time, for triage; TELEGRAM for an unmatched sender
  kind           String    @default("BUG") // BUG | FEATURE
  source         String    @default("APP") // APP | TELEGRAM
  title          String
  description    String
  // A path only, validated by sanitizePagePath — never a URL.
  pagePath       String?
  // Filled only by a report drawn on the screen. The browser sends all of
  // them but `build`, so all of them but `build` are untrusted and pass
  // through readDiagnostics, which drops what does not fit rather than
  // refusing the report. `build` is the server's own commit, never the form's.
  viewport       String? // "1061×1084 @2x"
  theme          String? // light | dark
  userAgent      String?
  build          String?
  marks          Int?
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | IN_REVIEW | FIXED | CLOSED
  // What the sender wrote or said, verbatim — the description is the model's
  // tidy version of it, and a triager settling "is that what they meant?"
  // needs the words. Voice notes are stored as their transcript, never audio.
  telegramAuthor String?
  originalText   String?
  resolution     String?
  resolvedAt     DateTime?
  // YYYY-MM-DD, the changelog entry a fix shipped in.
  changelogDate  String?
  triagedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reporter  User?             @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  triagedBy User?             @relation("BugTriager", fields: [triagedById], references: [id], onDelete: SetNull)
  image     BugReportImage?
  messages  TelegramMessage[]

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

// Every group message the bot has read, by id — kept or not. Two jobs:
//
//   - Telegram redelivers an update it thinks we missed, and the unique key is
//     what makes a redelivery a no-op instead of a second report.
//   - A reply in the group names the message it answers. When that message
//     belongs to a report, the reply is folded into it rather than judged on
//     its own, so "same on my phone" lands on the bug it is about.
//
// A message that was chatter keeps its ids and nothing else: its words are
// never stored.
model TelegramMessage {
  id        String   @id @default(cuid())
  chatId    String
  messageId Int
  reportId  String?
  createdAt DateTime @default(now())

  report BugReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@unique([chatId, messageId])
  @@index([reportId])
}

// One screenshot per report, in its own table for the reason AvatarImage is:
// Prisma selects every scalar, and a list of reports must not drag image bytes
// into memory. Only /api/bug-report/[id]/image reads this table.
model BugReportImage {
  id       String @id @default(cuid())
  reportId String @unique
  bytes    Bytes
  mimeType String

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ── University applications ─────────────────────────────────────────────
//
// What a student is applying with, for the programs that set
// `tracksAdmissions`. One record per STUDENT, not per enrollment: the
// application is theirs, and it must survive the ordinary move from Pre-Full
// Support into Full Support without being re-typed. Who may read it is still a
// question about programs — see `applicationAccess` in lib/authz.ts.

// The snapshot and the motivational essay. Created on the first save, so a
// student nobody has touched has no row and reads as "not started".
model StudentApplication {
  id          String   @id @default(cuid())
  studentId   String   @unique
  sat         Int? // 400–1600
  ielts       Float? // 0–9, in halves
  school      String?
  // Free text, as the student's school writes it: scales differ (4.0, 5,
  // 100%) and a number column would have to pick one.
  gpa         String?
  // BRAINSTORMING | WRITING | FINALIZING | DONE, or null for not started
  // (lib/applications.ts).
  essayStage  String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy User?          @relation("ApplicationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// The shared list of universities, each with its supplemental essays' total
// word count. Entered ONCE, by whoever first adds the university to a
// student's list; after that it is picked, and the count comes with it. Only a
// program admin corrects a count, and the correction reaches every student who
// lists it — the count is the university's, not the student's.
model University {
  id                String   @id @default(cuid())
  name              String
  // `name` lowercased and trimmed, so "Princeton University" is entered once
  // however it is typed.
  nameKey           String   @unique
  supplementalWords Int
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy User?               @relation("UniversityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  students  StudentUniversity[]
}

// One university on one student's list, with its supplemental essay's stage.
// At most one per student is `isPrimary`; only the primary carries a `round`.
model StudentUniversity {
  id           String   @id @default(cuid())
  studentId    String
  universityId String
  isPrimary    Boolean  @default(false)
  // ED | REA | EA, or null. Optional, and only on the primary.
  round        String?
  // The same four stages as the motivational essay, or null for not started.
  essayStage   String?
  createdAt    DateTime @default(now())

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university University     @relation(fields: [universityId], references: [id])

  @@unique([studentId, universityId])
}

// A mentor's Google Calendar and Meet, connected so that a meeting they held
// arrives in Freshlog already measured. Read-only on Google's side: nothing
// here can create, change or join a meeting.
//
// Its own grant, not the sign-in's. Students sign in with Google too, and must
// never be asked for their calendar; and a mentor who disconnects here is
// still signed in.
model GoogleConnection {
  userId       String    @id
  // The Google account that granted access. Always the mentor's own sign-in
  // address — a connection made from any other account is refused.
  googleEmail  String
  // AES-256-GCM under GOOGLE_TOKEN_KEY (lib/google/tokens.ts). A database
  // backup must not be a key to every mentor's calendar.
  refreshToken String
  scope        String
  createdAt    DateTime  @default(now())
  // The last run that reached Google for this mentor, successful or not.
  lastSyncAt   DateTime?
  // Set when Google refused the stored grant — revoked, password changed,
  // expired. The sync skips the mentor and their Needs-you list says to
  // reconnect, until they do.
  failedAt     DateTime?
  lastError    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A meeting Google Meet saw, measured and waiting for the mentor to log it.
//
// NOT a Session. A draft charges nothing and moves no balance: the only way
// time leaves an allocation is still the mentor saving the ordinary log form,
// which this pre-fills. So every rule that form enforces — reach, the
// program's allocation, an exchange's cap, the student's answer — still holds,
// because nothing here goes around it.
model MeetDraft {
  id         String   @id @default(cuid())
  mentorId   String
  studentId  String
  // Which program the meeting belongs to, when only one could be meant: the
  // only program in which this mentor holds time with this student. Null when
  // there are two or none, and the mentor picks — never a guess, because a
  // guess here spends one program's hours out of another's grant.
  programId  String?
  // The Calendar event. With the mentor and the student, what makes a re-run
  // of the sync find the same draft instead of writing a second.
  eventId    String
  // When the meeting was booked to start, and the day it falls on in the
  // calendar's own time zone (UTC midnight, the way Session.date is stored).
  startsAt   DateTime
  date       DateTime
  // Measured from Meet's join and leave times, not the booking: the time both
  // the mentor and the student were in the call, rounded to five minutes.
  minutes    Int
  // ATTENDED | LATE | ABSENT, or null when Meet could not say which of the
  // people in the call was the student.
  attendance String?
  createdAt  DateTime @default(now())

  mentor  User           @relation("MeetDraftMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([mentorId, eventId, studentId])
  @@index([mentorId, date])
}

// A partner school whose students rate our mentors and sessions through a public
// link, /f/<slug>, without an account here. The partner is NOT a program and its
// feedback is NOT a student's feedback in the AGENTS.md sense, so none of these
// four tables carries a `programId` or touches the ledger.
model FeedbackPartner {
  id        String   @id @default(cuid())
  slug      String   @unique // the deep link: /f/<slug>; lowercase a-z, 0-9, "-"
  name      String // "Cana"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  students PartnerStudent[]
  mentors  PartnerMentor[]
  feedback PartnerFeedback[]
}

// An email allowed through a partner's form. Stored trimmed and lowercased.
// Removing a row stops new feedback from that address; what it already wrote
// stays, because PartnerFeedback copies the email rather than pointing here.
model PartnerStudent {
  id        String   @id @default(cuid())
  partnerId String
  email     String // stored trimmed and lowercased
  createdAt DateTime @default(now())

  partner FeedbackPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, email])
}

// The mentors a partner's students may rate: the ticked ones. Unticking removes
// the mentor from the dropdown; their feedback stays and is still filterable.
model PartnerMentor {
  partnerId String
  mentorId  String

  partner FeedbackPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  mentor  User            @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([partnerId, mentorId])
}

enum PartnerFeedbackKind {
  MENTOR
  SESSION
}

// One piece of feedback from a partner's student. MENTOR rates a mentor;
// SESSION rates a numbered session and carries the student's name.
model PartnerFeedback {
  id            String              @id @default(cuid())
  partnerId     String
  kind          PartnerFeedbackKind
  studentEmail  String // copied, not a FK: removing an email from the list keeps its feedback
  mentorId      String? // MENTOR only
  sessionNumber Int? // SESSION only, >= 1
  name          String? // SESSION only, required there
  rating        Int // 1-5
  comment       String
  createdAt     DateTime            @default(now())

  partner FeedbackPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  mentor  User?           @relation("PartnerFeedbackMentor", fields: [mentorId], references: [id])

  @@index([partnerId, createdAt])
}
