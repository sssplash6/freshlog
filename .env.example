# ── Database ─────────────────────────────────────────────────────────────
# Local dev: a SQLite file inside the repo (gitignored).
# Render:    point at the persistent disk, e.g. file:/data/app.db
DATABASE_URL="file:./prisma/dev.db"

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ─────
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Auth.js ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The canonical URL of the site (http://localhost:3000 in dev,
# https://<your-service>.onrender.com on Render). Also the base for links in
# outbound email, and NEXTAUTH_SECRET signs the unsubscribe tokens.
NEXTAUTH_URL="http://localhost:3000"

# ── Cron (guards /api/cron/*) ────────────────────────────────────────────
# Any long random string; the Render cron jobs send it as a bearer token.
CRON_SECRET=""

# ── Outbound email — the weekly hours digest (https://resend.com) ────────
# Leave BOTH blank to keep email in dry-run: the digest still composes and logs
# every message it would have sent, and the cron response reports live: false.
# Nothing is delivered until both are set.
#
# EMAIL_FROM's domain must be verified at Resend first (SPF + DKIM records).
RESEND_API_KEY=""
EMAIL_FROM="Freshman Academy <hours@freshlog.net>"

# ── Dictated session notes (speech → tidy text) ──────────────────────────
# A mentor speaks their session note; MAI-Transcribe-2 transcribes it and a
# small model fixes the grammar. Leave ANY of the three blank to keep the
# feature switched off — the mic button hides itself and the Notes box is
# typed into as before. Nothing is ever stored: the audio lives for one
# request and the text only reaches the database if the mentor saves the form.
#
# Azure portal → Create a resource → Azure AI Foundry (Speech), then
# Keys and Endpoint. MAI-Transcribe runs in SIX regions only:
#   eastus, westus, westus2, northeurope, centralindia, southeastasia
# A resource in any other region answers ordinary speech requests and rejects
# `enhancedMode`, which is the failure that looks like a bad key.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"

# openrouter.ai → Keys. Reaches anthropic/claude-haiku-4.5 for the tidying
# pass; about $0.0024 a session, all in.
OPENROUTER_API_KEY=""
