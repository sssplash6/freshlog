# ── Database ─────────────────────────────────────────────────────────────
# Local dev: a SQLite file inside the repo (gitignored).
# Render:    point at the persistent disk, e.g. file:/data/app.db
DATABASE_URL="file:./prisma/dev.db"

# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ─────
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Auth.js ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The canonical URL of the site (http://localhost:3000 in dev,
# https://<your-service>.onrender.com on Render). Also the base for links in
# outbound email, and NEXTAUTH_SECRET signs the unsubscribe tokens.
NEXTAUTH_URL="http://localhost:3000"

# ── Cron (guards /api/cron/*) ────────────────────────────────────────────
# Any long random string; the Render cron jobs send it as a bearer token.
CRON_SECRET=""

# ── Outbound email — the weekly hours digest (https://resend.com) ────────
# Leave BOTH blank to keep email in dry-run: the digest still composes and logs
# every message it would have sent, and the cron response reports live: false.
# Nothing is delivered until both are set.
#
# EMAIL_FROM's domain must be verified at Resend first (SPF + DKIM records).
RESEND_API_KEY=""
EMAIL_FROM="Freshman Academy <hours@freshlog.net>"

# ── Dictated session notes (speech → tidy text) ──────────────────────────
# A mentor speaks their session note and gets written English back. One call
# to one audio-capable model does both the hearing and the tidying. Leave this
# blank to keep the feature off — the mic button hides itself and the Notes box
# is typed into as before.
#
# Nothing is ever stored: the audio lives for one request, and the text only
# reaches the database if the mentor saves the form. About $0.0013 a note.
#
# openrouter.ai → Keys.
OPENROUTER_API_KEY=""

# ── Bug reports from the Telegram group ──────────────────────────────────
# A bot reads every message in the team's feedback group and files the bugs
# and feature requests on /bugs/triage, using OPENROUTER_API_KEY above to read
# text, voice notes and screenshots. All three below are needed; leave any
# blank to keep it off.
#
#   1. @BotFather → /newbot → TELEGRAM_BOT_TOKEN
#   2. @BotFather → /setprivacy → Disable (or the bot sees only commands)
#   3. Add the bot to the group, send a message, then
#      `node scripts/telegram-webhook.mjs chats` → TELEGRAM_CHAT_ID
#   4. Deploy, then `node scripts/telegram-webhook.mjs set https://www.freshlog.net`
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""   # any long random string: openssl rand -hex 32
TELEGRAM_CHAT_ID=""
